# No trailing slash: also matches a symlinked node_modules (shared worktrees).
node_modules
dist/
.env
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Claude Code local config
.claude/
# OpenCode local config
.opencode/
# Development plans & review notes. docs/ and scripts/ are tracked by default;
# anchor scratch-note patterns to this directory so they never swallow real
# documents such as docs/guides/codex-wsl-clarification.md.
/.release-reviews/
/PLAN.md
/PLAN-*.md
/codex-*.md
/CHANGELOG-draft.md

# Temp files from testing
.tmp_*
.tmp-*
*.tmp

# Root-level scratch files (tmp-*.md / tmp-*.json / tmp-*.sh etc.)
# Matches files like tmp-pr301-comment.md, tmp-issues.json at repo root only.
/tmp-*

# Local manual test / tuning scratch docs (root-level dotfile md)
.*-test-*.md
.*-tune-*.md
.*-tune.md


# Calico animation studio (WIP pipeline, not for distribution)
calico-studio/

# WIP artwork (unpublished, All Rights Reserved)
tools/calico-*
!tools/calico-final.svg

# Internal pipeline tools (not for distribution)
tools/chroma_key.py
tools/fix_gray_bleed.py
tools/rebuild_apng.py
tools/check_dark.py
!tools/calico-test.html

# Debug logs
logs/

# oh-my-cursor state
.omc/

# Cursor local config (MCP, rules from omc setup)
.cursor/

# VS Code local config
.vscode/

# Local agent/skill definitions (machine-specific)
.agents/

# Local git worktrees used for PR review
.worktrees/

# Playwright MCP session artifacts (screenshots, downloaded installers — hundreds of MB)
.playwright-mcp/

# Retired Telegram sidecar binaries. The sidecar was removed in v0.14.0 and every
# release build asserts it is absent (scripts/assert-no-retired-telegram-sidecar.js);
# stale local copies must never re-enter the repository.
bin/

# PowerShell module analysis cache that Windows sometimes drops at the repo root
Microsoft/

# Emoji export scratch
clawd-emoji-final/
